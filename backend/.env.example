# 客户端业务库按首页登录账号从此维护连接派生，不设置固定 DATABASE_URL。
# 该连接用于检查、创建及迁移账号数据库，须具备建库、建表和创建 vector 扩展的权限。
# 默认角色 miaoshou_client 须先在本机创建；密码认证时在本机 .env 填写完整连接串。
ACCOUNT_DATABASE_ADMIN_URL=postgresql://miaoshou_client@127.0.0.1:5432/postgres

# server/backend 的根地址，用于账号校验、店铺选项、配置和模型服务读取。
MIAOSHOU_SERVER_CONFIG_URL=http://127.0.0.1:3001
# 与 server/backend 同值；配置后从服务端读取生产模型服务，未配置时读取本地 model_services。
SERVER_MODEL_READ_TOKEN=
# 与 server/backend 同值的 32 字节密钥（64 位十六进制）；用于解密服务端传输的模型 API Key。
# 启用 SERVER_MODEL_READ_TOKEN 时必须同时配置。
SERVER_MODEL_DATA_KEY=
# 与 server/backend 同值；客户端首页登录及 API 凭证指纹校验使用。
CLIENT_LOGIN_TOKEN=

# 阿里云 OSS 图片存储。以下四项用于上传和读取图片；密钥仅填写在本机 .env。
# Bucket 名称，例如 miaoshou-images；不包含域名或路径。
OSS_BUCKET=
# Bucket 地域，例如 oss-cn-hangzhou；使用公网 HTTPS endpoint，不填 -internal。
OSS_REGION=
# RAM 凭证需具备对应目录的 oss:PutObject、oss:GetObject、oss:PutObjectAcl 权限。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
